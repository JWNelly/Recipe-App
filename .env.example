# Copy this file to .env and fill in your Firebase web app values.
# Find these in the Firebase console: Project settings → General → Your apps → SDK setup and configuration → Config.
# These values are safe to expose publicly — Firestore security rules protect the data.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
